# Shared secret the ITSM webhook sends in the X-Webhook-Token header
WEBHOOK_TOKEN=change-me

# dry-run (default, safe for testing) or powershell (domain-joined Windows host)
PROVISIONER=dry-run

# Optional: write results back to ManageEngine ServiceDesk Plus
# SDP_BASE_URL=https://servicedesk.example.com
# SDP_API_KEY=
# SDP_VERIFY_TLS=true

LOG_LEVEL=INFO
